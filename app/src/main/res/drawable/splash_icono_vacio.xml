<?xml version="1.0" encoding="utf-8"?>
<!-- Ícono transparente para el splash nativo de Android 12+: oculta el ícono del launcher
     y deja solo el fondo blanco, para que SplashScreen (Compose) sea lo único con logo. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#00000000" />
    <size
        android:width="1dp"
        android:height="1dp" />
</shape>
