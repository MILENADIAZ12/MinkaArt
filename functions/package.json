{
  "name": "functions",
  "description": "Cloud Functions para MinkaArt - verificación de correo por código",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "rellenar-embeddings": "npm run build && node lib/scripts/rellenarEmbeddings.js"
  },
  "dependencies": {
    "@types/nodemailer": "^6.4.16",
    "firebase-admin": "12.6.0",
    "firebase-functions": "5.1.1",
    "google-auth-library": "9.14.2",
    "nodemailer": "^6.9.15"
  },
  "devDependencies": {
    "typescript": "5.5.4"
  },
  "private": true
}
